# SimplerEnv evaluation environment
# Includes ManiSkill2_real2sim + SimplerEnv.

ARG BASE_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base:latest
ARG RUNTIME_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base-render:latest
FROM ${BASE_IMAGE} AS builder

# ── uv environment ──────────────────────────────────────────────────
ARG PYTHON_VERSION=3.10.18
RUN uv python install "${PYTHON_VERSION}" \
    && uv venv --seed --python "${PYTHON_VERSION}" /opt/venv
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# ── ManiSkill2_real2sim + SimplerEnv source ───────────────────────────
WORKDIR /app
ARG MANISKILL2_REAL2SIM_REF=ef7a4d4fdf4b69f2c2154db5b15b9ac8dfe10682
RUN mkdir -p /app/ManiSkill2_real2sim \
    && cd /app/ManiSkill2_real2sim \
    && git init -q \
    && git remote add origin https://github.com/simpler-env/ManiSkill2_real2sim.git \
    && git fetch -q --depth 1 origin "${MANISKILL2_REAL2SIM_REF}" \
    && git checkout -q FETCH_HEAD \
    && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt \
    && rm -rf .git

ARG SIMPLER_ENV_REF=4ab7178e83e84ee06894034ec6dbf9e7aad1e882
RUN mkdir -p /app/simpler_env_src \
    && cd /app/simpler_env_src \
    && git init -q \
    && git remote add origin https://github.com/simpler-env/SimplerEnv.git \
    && git fetch -q --depth 1 origin "${SIMPLER_ENV_REF}" \
    && git checkout -q FETCH_HEAD \
    && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt \
    && rm -rf .git

# ── Install simulation stack ──────────────────────────────────────────
# sapien imports pkg_resources, removed from conda-forge setuptools >=70.
RUN uv pip install --no-cache-dir "setuptools<70"
# ruckig 0.17.3's pyproject uses cmake.targets, removed in scikit-build-core >= 0.10.
RUN printf 'scikit-build-core<0.10\n' > /tmp/build-constraints.txt \
    && cd /app/ManiSkill2_real2sim \
    && uv pip install --no-cache-dir --build-constraints /tmp/build-constraints.txt -e .
RUN cd /app/simpler_env_src && uv pip install --no-cache-dir -e .

# opencv-python 4.12 pulls numpy>=2, but SimplerEnv needs numpy 1.24.
# Install opencv first, then force-downgrade numpy.
RUN uv pip install --no-cache-dir \
        matplotlib mediapy omegaconf hydra-core \
        opencv-python==4.12.0.88
RUN uv pip install --no-cache-dir numpy==1.24.4

# ── Symlink for rgb_overlay_path config compatibility ─────────────────
RUN mkdir -p /app/simpler \
    && ln -sfn /app/ManiSkill2_real2sim /app/simpler/ManiSkill2_real2sim

WORKDIR /workspace
COPY pyproject.toml README.md ./
COPY src/ src/
ARG HARNESS_VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${HARNESS_VERSION}
RUN uv pip install --no-cache-dir -e .
COPY configs/ configs/

# Export the final filesystem state; superseded wheels and build layers stay behind.
RUN python /usr/local/lib/vla/export_runtime.py /opt/python /opt/venv /app /workspace /root

FROM ${RUNTIME_IMAGE} AS runtime
COPY --from=builder /runtime-root/opt/python /opt/python
COPY --from=builder /runtime-root/opt/venv /opt/venv
COPY --from=builder /runtime-root/app /app
COPY --from=builder /runtime-root/workspace /workspace
COPY --from=builder /runtime-root/root /root
COPY --from=builder /runtime-root/usr/local/share/vla-build /usr/local/share/vla-build
RUN dpkg-query -W > /usr/local/share/vla-build/dpkg-runtime.txt
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH
WORKDIR /workspace
RUN vla-eval --help > /dev/null
ENTRYPOINT ["vla-eval"]
CMD ["run", "--config", "/workspace/configs/benchmarks/simpler/widowx_vm.yaml"]
