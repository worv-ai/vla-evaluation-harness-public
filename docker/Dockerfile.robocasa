# Generated by docker/render.py; edit docker/recipes and docker/images.json.
# RoboCasa kitchen manipulation evaluation environment
#
# Pinned to the original RoboCasa release. The successor release is a
# separate, API-incompatible integration — see Dockerfile.robocasa365.

ARG BASE_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base:latest
ARG RUNTIME_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base-render:latest
FROM ${BASE_IMAGE} AS sources
ARG ROBOCASA_ROBOSUITE_REF=1a8701b90c07c6595ace4af9935d7c5ebe1baed3
RUN mkdir -p /app/robosuite && cd /app/robosuite && git init -q && git remote add origin https://github.com/ARISE-Initiative/robosuite.git && git fetch -q --depth 1 origin "${ROBOCASA_ROBOSUITE_REF}" && git checkout -q FETCH_HEAD && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt
ARG ROBOCASA_REF=756598a5be52e052339bb2d957426e39015c2afb
RUN mkdir -p /app/robocasa && cd /app/robocasa && git init -q && git remote add origin https://github.com/robocasa/robocasa.git && git fetch -q --depth 1 origin "${ROBOCASA_REF}" && git checkout -q FETCH_HEAD && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt
FROM ${BASE_IMAGE} AS builder

# Python 3.10: RoboCasa v0.2 pins numba==0.56.4, whose llvmlite has no
# cp311 wheel.
ARG PYTHON_VERSION=3.10.18
RUN uv python install "${PYTHON_VERSION}" \
    && uv venv --seed --python "${PYTHON_VERSION}" /opt/venv
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# robosuite v1.5.0 is the release RoboCasa v0.2 was cut against.
# ARISE-Initiative/robosuite v1.5.0
COPY --from=sources /usr/local/share/vla-build/sources.txt /usr/local/share/vla-build/sources.txt
COPY --from=sources /app/robosuite /app/robosuite
RUN mkdir -p /app/robosuite &&      cd /app/robosuite &&      uv pip install --no-cache-dir -e . &&      rm -rf /app/robosuite/.git

# robocasa/robocasa v0.2

COPY --from=sources /app/robocasa /app/robocasa
RUN mkdir -p /app/robocasa &&      cd /app/robocasa &&      uv pip install --no-cache-dir -e . &&      rm -rf /app/robocasa/.git

# Setup macros (non-interactive) and download kitchen assets (~10 GB)

RUN cd /app/robocasa \
    && python robocasa/scripts/setup_macros.py \
    && echo "y" | python robocasa/scripts/download_kitchen_assets.py

WORKDIR /workspace
COPY pyproject.toml README.md ./
COPY src/ src/
ARG HARNESS_VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${HARNESS_VERSION}
# robocasa/__init__.py asserts numpy is 1.23.{2,3,5}, which the harness floor of
# >=1.24 would pull out from under it. Restore RoboCasa's pin after installing;
# the harness test suite passes on 1.23.3.
ARG ROBOCASA_NUMPY=1.23.3

ARG TORCH_BACKEND=cpu
ENV UV_TORCH_BACKEND=${TORCH_BACKEND}

RUN uv pip install --no-cache-dir -e . && \
    uv pip install --no-cache-dir "numpy==${ROBOCASA_NUMPY}"
COPY configs/ configs/
COPY docker/images.json /usr/local/lib/vla/images.json
ARG IMAGE_PROFILE=gpu
COPY docker/locks/robocasa-${IMAGE_PROFILE}.txt /usr/local/lib/vla/locks/robocasa-${IMAGE_PROFILE}.txt
COPY docker/locks/assets.json /usr/local/lib/vla/locks/assets.json
RUN mkdir -p /app /root
RUN python /usr/local/lib/vla/install_locked.py robocasa "$IMAGE_PROFILE"
RUN if [ "$IMAGE_PROFILE" = cpu ]; then python /usr/local/lib/vla/prepare_cpu.py && python /usr/local/lib/vla/prune_cpu.py; fi
RUN python /usr/local/lib/vla/export_runtime.py --inventory-only /opt/python /opt/venv /app /workspace /root
FROM builder AS assembled
RUN python /usr/local/lib/vla/assemble.py robocasa
FROM scratch AS assets
COPY --from=assembled /app/robocasa/robocasa/models/assets /app/robocasa/robocasa/models/assets
COPY --from=assembled /app/robosuite/robosuite/models/assets /app/robosuite/robosuite/models/assets
COPY --from=assembled /runtime-root/usr/local/share/vla-build/assets.json /usr/local/share/vla-build/assets.json
FROM ${RUNTIME_IMAGE} AS runtime
ARG IMAGE_PROFILE=gpu
ENV VLA_IMAGE_PROFILE=${IMAGE_PROFILE}
COPY --from=assembled /runtime-root/opt/python /opt/python
COPY --from=assembled /runtime-root/opt/venv /opt/venv
COPY --from=assembled /runtime-root/app /app
COPY --from=assembled /runtime-root/workspace /workspace
COPY --from=assembled /runtime-root/root /root
COPY --from=assembled /runtime-root/usr/local/share/vla-build /usr/local/share/vla-build
RUN dpkg-query -W > /usr/local/share/vla-build/dpkg-runtime.txt
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH
WORKDIR /workspace
RUN vla-eval --help > /dev/null
ENTRYPOINT ["/usr/local/bin/image-entrypoint", "vla-eval"]
CMD ["run", "--config", "/workspace/configs/benchmarks/robocasa/eval.yaml"]
FROM runtime AS full
COPY --from=assets /app/robocasa/robocasa/models/assets /app/robocasa/robocasa/models/assets
COPY --from=assets /app/robosuite/robosuite/models/assets /app/robosuite/robosuite/models/assets
