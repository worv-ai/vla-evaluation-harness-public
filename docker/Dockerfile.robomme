# Generated by docker/render.py; edit docker/recipes and docker/images.json.
# RoboMME evaluation environment (ManiSkill3 fork + SAPIEN, Vulkan rendering)

ARG BASE_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base:latest
ARG RUNTIME_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base-render:latest
FROM ${BASE_IMAGE} AS sources
ARG ROBOMME_MANISKILL_REF=07be6fbc66350ddca200abfb0a11b692f078f7fd
RUN mkdir -p /app/ManiSkill && cd /app/ManiSkill && git init -q && git remote add origin https://github.com/YinpeiDai/ManiSkill.git && git fetch -q --depth 1 origin "${ROBOMME_MANISKILL_REF}" && git checkout -q FETCH_HEAD && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt
ARG ROBOMME_BENCHMARK_REF=f2b540e64034cf9afd0b51cf8ec491de09c74f58
RUN mkdir -p /app/robomme_benchmark && cd /app/robomme_benchmark && git init -q && git remote add origin https://github.com/RoboMME/robomme_benchmark.git && git fetch -q --depth 1 origin "${ROBOMME_BENCHMARK_REF}" && git checkout -q FETCH_HEAD && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt
FROM ${BASE_IMAGE} AS builder

# ── uv environment (Python 3.11 per RoboMME requirement) ──────────────
ARG PYTHON_VERSION=3.11.13
RUN uv python install "${PYTHON_VERSION}" \
    && uv venv --seed --python "${PYTHON_VERSION}" /opt/venv
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# ── PyTorch with CUDA (RoboMME envs use torch for scene randomization) ───
# Match the existing release: upstream pins with official CUDA 12.8 wheels.
ARG TORCH_BACKEND=cu128
ENV UV_TORCH_BACKEND=${TORCH_BACKEND}

RUN uv pip install --no-cache-dir "torch==2.9.1" "torchvision==0.24.1"

# ── setuptools (RoboMME pins 80.9.0) ────────────────────────────────────
RUN uv pip install --no-cache-dir "setuptools==80.9.0"

# ── Custom ManiSkill fork ────────────────────────────────────────────────
WORKDIR /app
COPY --from=sources /usr/local/share/vla-build/sources.txt /usr/local/share/vla-build/sources.txt
COPY --from=sources /app/ManiSkill /app/ManiSkill
RUN mkdir -p /app/ManiSkill      && cd /app/ManiSkill && rm -rf .git

RUN cd /app/ManiSkill && uv pip install --no-cache-dir -e .

# ── RoboMME benchmark ───────────────────────────────────────────────────
COPY --from=sources /app/robomme_benchmark /app/robomme_benchmark
RUN mkdir -p /app/robomme_benchmark      && cd /app/robomme_benchmark && rm -rf .git

RUN cd /app/robomme_benchmark && uv pip install --no-cache-dir -e .

# ── Additional runtime deps (h5py imported by DemonstrationWrapper) ─────
RUN uv pip install --no-cache-dir "opencv-python>=4.11.0.86" h5py imageio
COPY docker/images.json /usr/local/lib/vla/images.json
ARG IMAGE_PROFILE=gpu
COPY docker/locks/robomme-${IMAGE_PROFILE}.txt /usr/local/lib/vla/locks/robomme-${IMAGE_PROFILE}.txt
COPY docker/locks/assets.json /usr/local/lib/vla/locks/assets.json
RUN mkdir -p /app /root
RUN python /usr/local/lib/vla/install_locked.py robomme "$IMAGE_PROFILE"
WORKDIR /workspace
COPY pyproject.toml README.md ./
COPY src/ src/
ARG HARNESS_VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${HARNESS_VERSION}
RUN uv pip install --no-cache-dir --no-deps -e .
COPY configs/ configs/
RUN if [ "$IMAGE_PROFILE" = cpu ]; then python /usr/local/lib/vla/prepare_cpu.py && python /usr/local/lib/vla/prune_cpu.py; fi
RUN python /usr/local/lib/vla/export_runtime.py --inventory-only /opt/python /opt/venv /app /workspace /root
FROM builder AS assembled
RUN python /usr/local/lib/vla/assemble.py robomme
FROM scratch AS assets
COPY --from=assembled /app/ManiSkill/mani_skill/assets /app/ManiSkill/mani_skill/assets
COPY --from=assembled /app/robomme_benchmark/assets /app/robomme_benchmark/assets
COPY --from=assembled /runtime-root/usr/local/share/vla-build/assets.json /usr/local/share/vla-build/assets.json
FROM ${RUNTIME_IMAGE} AS runtime
ARG IMAGE_PROFILE=gpu
ENV VLA_IMAGE_PROFILE=${IMAGE_PROFILE}
COPY --from=assembled /runtime-root/opt/python /opt/python
COPY --from=assembled /runtime-root/opt/venv /opt/venv
COPY --from=assembled /runtime-root/app /app
COPY --from=assembled /runtime-root/workspace /workspace
COPY --from=assembled /runtime-root/root /root
COPY --from=assembled /runtime-root/usr/local/share/vla-build /usr/local/share/vla-build
RUN dpkg-query -W > /usr/local/share/vla-build/dpkg-runtime.txt
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH
WORKDIR /workspace
RUN vla-eval --help > /dev/null
ENTRYPOINT ["/usr/local/bin/image-entrypoint", "vla-eval"]
CMD ["run", "--config", "/workspace/configs/benchmarks/robomme/eval.yaml"]
FROM runtime AS full
COPY --from=assets /app/ManiSkill/mani_skill/assets /app/ManiSkill/mani_skill/assets
COPY --from=assets /app/robomme_benchmark/assets /app/robomme_benchmark/assets
