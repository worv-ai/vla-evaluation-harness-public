# VLABench evaluation environment (MuJoCo-based)

ARG BASE_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base:latest
ARG RUNTIME_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base-cpu:latest
FROM ${BASE_IMAGE} AS builder
ENV UV_TORCH_BACKEND=cpu

ENV VLABENCH_ROOT=/app/VLABench/VLABench

ARG PYTHON_VERSION=3.10.18
RUN uv python install "${PYTHON_VERSION}" \
    && uv venv --seed --python "${PYTHON_VERSION}" /opt/venv
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install MuJoCo, dm_control, and numpy first
RUN uv pip install --no-cache-dir \
        mujoco==3.2.2 \
        dm_control==1.0.22 \
        numpy==1.25.0

RUN uv pip install --no-cache-dir \
        gym==0.26.2 \
        gymnasium==0.29.1 \
        opencv-python \
        scipy==1.14.0 \
        h5py==3.11.0 \
        mediapy==1.2.0 \
        imageio \
        gdown \
        colorlog \
        colorama \
        ipdb \
        Pillow \
        open3d==0.18.0 \
        scikit-learn \
        openai

ARG RRT_ALGORITHMS_REF=e51d95ee489a225220d6ae2a764c4111f6ba7d85
RUN mkdir -p /app/rrt-algorithms && \
    cd /app/rrt-algorithms && \
    git init -q && \
    git remote add origin https://github.com/motion-planning/rrt-algorithms.git && \
    git fetch -q --depth 1 origin "${RRT_ALGORITHMS_REF}" && \
    git checkout -q FETCH_HEAD \
    && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt && \
    uv pip install --no-cache-dir -e . && \
    rm -rf /app/rrt-algorithms/.git

ARG VLABENCH_REF=cf588fe60c0c7282174fe979f5913170cfe69017
RUN mkdir -p /app/VLABench && \
    cd /app/VLABench && \
    git init -q && \
    git remote add origin https://github.com/OpenMOSS/VLABench.git && \
    git fetch -q --depth 1 origin "${VLABENCH_REF}" && \
    git checkout -q FETCH_HEAD \
    && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt && \
    uv pip install --no-cache-dir -e . && \
    rm -rf /app/VLABench/.git

# Download assets (obj + scene from Google Drive)
RUN cd /app/VLABench && \
    python scripts/download_assets.py

WORKDIR /workspace
COPY pyproject.toml README.md ./
COPY src/ src/
ARG HARNESS_VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${HARNESS_VERSION}
RUN uv pip install --no-cache-dir -e .
COPY configs/ configs/

# Export the final filesystem state; superseded wheels and build layers stay behind.
RUN python /usr/local/lib/vla/export_runtime.py /opt/python /opt/venv /app /workspace /root

FROM ${RUNTIME_IMAGE} AS runtime
COPY --from=builder /runtime-root/ /
RUN dpkg-query -W > /usr/local/share/vla-build/dpkg-runtime.txt
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH
ENV VLABENCH_ROOT=/app/VLABench/VLABench
WORKDIR /workspace
RUN vla-eval --help > /dev/null
ENTRYPOINT ["vla-eval"]
CMD ["run", "--config", "/workspace/configs/benchmarks/vlabench/eval.yaml"]
