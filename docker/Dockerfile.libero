ARG BASE_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base:latest
ARG RUNTIME_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base-render:latest
FROM ${BASE_IMAGE} AS builder
ENV UV_TORCH_BACKEND=cpu

# ── Locked native environment ──────────────────────────────────────────────
RUN install-native-env py38
ENV CONDA_PREFIX=/opt/pixi/.pixi/envs/py38 \
    PATH=/opt/pixi/.pixi/envs/py38/bin:$PATH
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# ── CPU-only PyTorch ───────────────────────────────────────────────
RUN uv pip install --no-cache-dir "torch==2.1.0" \
        --torch-backend cpu

# ── Python dependencies ───────────────────────────────────────────
RUN uv pip install --no-cache-dir \
        numpy==1.22.4 mujoco==3.2.3 robosuite==1.4.0 bddl==1.0.1 \
        Pillow scipy h5py pyyaml termcolor future easydict hydra-core \
        "gym>=0.21,<0.27" matplotlib \
    && rm -rf ~/.cache/pip ~/.cache/uv

# ── Clone LIBERO ───────────────────────────────────────────────────
ARG LIBERO_REF=8f1084e3132a39270c3a13ebe37270a43ece2a01
RUN mkdir -p /app/libero \
    && cd /app/libero \
    && git init -q \
    && git remote add origin https://github.com/Lifelong-Robot-Learning/LIBERO.git \
    && git fetch -q --depth 1 origin "${LIBERO_REF}" \
    && git checkout -q FETCH_HEAD \
    && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt \
    && uv pip install --no-cache-dir --config-setting editable_mode=compat -e . \
    && rm -rf /app/libero/.git ~/.cache/uv

# ── Pre-create LIBERO config (suppress interactive prompt) ─────────
RUN mkdir -p /root/.libero && printf '\
benchmark_root: /app/libero/libero/libero\n\
bddl_files: /app/libero/libero/libero/bddl_files\n\
init_states: /app/libero/libero/libero/init_files\n\
datasets: /app/libero/libero/datasets\n\
assets: /app/libero/libero/libero/assets\n' > /root/.libero/config.yaml

WORKDIR /workspace
COPY pyproject.toml README.md ./
COPY src/ src/
ARG HARNESS_VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${HARNESS_VERSION}
RUN uv pip install --no-cache-dir -e .
COPY configs/ configs/

# Export the final filesystem state; superseded wheels and build layers stay behind.
RUN python /usr/local/lib/vla/export_runtime.py /opt/pixi/.pixi/envs/py38 /app /workspace /root

FROM ${RUNTIME_IMAGE} AS runtime
ARG IMAGE_PROFILE=gpu
ENV VLA_IMAGE_PROFILE=${IMAGE_PROFILE}
COPY --from=builder /runtime-root/opt/pixi/.pixi/envs/py38 /opt/pixi/.pixi/envs/py38
COPY --from=builder /runtime-root/app /app
COPY --from=builder /runtime-root/workspace /workspace
COPY --from=builder /runtime-root/root /root
COPY --from=builder /runtime-root/usr/local/share/vla-build /usr/local/share/vla-build
RUN dpkg-query -W > /usr/local/share/vla-build/dpkg-runtime.txt
ENV CONDA_PREFIX=/opt/pixi/.pixi/envs/py38 \
    CONDA_DEFAULT_ENV=libero \
    PATH=/opt/pixi/.pixi/envs/py38/bin:$PATH
WORKDIR /workspace
RUN vla-eval --help > /dev/null
ENTRYPOINT ["/usr/local/bin/image-entrypoint", "vla-eval"]
CMD ["run", "--config", "/workspace/configs/benchmarks/libero/spatial.yaml"]
