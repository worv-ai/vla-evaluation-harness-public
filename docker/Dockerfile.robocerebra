# Generated by docker/render.py; edit docker/recipes and docker/images.json.
ARG BASE_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base:latest
ARG RUNTIME_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base-render:latest
FROM ${BASE_IMAGE} AS sources
ARG ROBOCEREBRA_REF=2573426c13dfcd5e7d7831c15587b058aaa1c0c0
RUN mkdir -p /tmp/RoboCerebra && cd /tmp/RoboCerebra && git init -q && git remote add origin https://github.com/qiuboxiang/RoboCerebra.git && git fetch -q --depth 1 origin "${ROBOCEREBRA_REF}" && git checkout -q FETCH_HEAD && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt
FROM ${BASE_IMAGE} AS builder

# ── Locked native environment ──────────────────────────────────────────────
RUN install-native-env py38
ENV CONDA_PREFIX=/opt/pixi/.pixi/envs/py38 \
    PATH=/opt/pixi/.pixi/envs/py38/bin:$PATH
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# ── CPU-only PyTorch ───────────────────────────────────────────────

ARG TORCH_BACKEND=cpu
ENV UV_TORCH_BACKEND=${TORCH_BACKEND}

RUN uv pip install --no-cache-dir "torch==2.1.0" \
        --torch-backend "${TORCH_BACKEND}"

# ── Python dependencies ───────────────────────────────────────────
RUN uv pip install --no-cache-dir \
        numpy==1.22.4 mujoco==3.2.3 robosuite==1.4.0 bddl==1.0.1 \
        Pillow scipy h5py pyyaml termcolor future easydict hydra-core \
        "gym>=0.21,<0.27" matplotlib \
    && rm -rf ~/.cache/pip ~/.cache/uv

# ── Clone RoboCerebra & install its custom LIBERO fork ─────────────
COPY --from=sources /usr/local/share/vla-build/sources.txt /usr/local/share/vla-build/sources.txt
COPY --from=sources /tmp/RoboCerebra /tmp/RoboCerebra
RUN mkdir -p /tmp/RoboCerebra \
    && cd /tmp/RoboCerebra \
    && cd /tmp/RoboCerebra/LIBERO \
    && uv pip install --no-cache-dir --config-setting editable_mode=compat -e . \
    && uv pip install --no-cache-dir "bddl==1.0.1" h5py \
    && rm -rf /tmp/RoboCerebra/.git ~/.cache/uv

# ── Download RoboCerebra benchmark data ────────────────────────────

ARG ROBOCEREBRA_ASSETS_REF=4e386b9aa266f05b199739d7b58950252244ea21
RUN uv pip install --no-cache-dir huggingface_hub \
    && huggingface-cli download qiukingballball/RoboCerebraBench \
        --repo-type dataset --revision "${ROBOCEREBRA_ASSETS_REF}" \
        --local-dir /workspace/RoboCerebra_Bench \
    && rm -rf ~/.cache/pip ~/.cache/uv

# ── Pre-create LIBERO config (suppress interactive prompt) ─────────
RUN mkdir -p /root/.libero && printf '\
benchmark_root: /tmp/RoboCerebra/LIBERO/libero/libero\n\
bddl_files: /tmp/RoboCerebra/LIBERO/libero/libero/bddl_files\n\
init_states: /tmp/RoboCerebra/LIBERO/libero/libero/init_files\n\
datasets: /tmp/RoboCerebra/LIBERO/libero/datasets\n\
assets: /tmp/RoboCerebra/LIBERO/libero/libero/assets\n' > /root/.libero/config.yaml

WORKDIR /workspace
COPY pyproject.toml README.md ./
COPY src/ src/
ARG HARNESS_VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${HARNESS_VERSION}
RUN uv pip install --no-cache-dir -e .
COPY configs/ configs/
COPY docker/images.json /usr/local/lib/vla/images.json
ARG IMAGE_PROFILE=gpu
COPY docker/locks/robocerebra-${IMAGE_PROFILE}.txt /usr/local/lib/vla/locks/robocerebra-${IMAGE_PROFILE}.txt
COPY docker/locks/assets.json /usr/local/lib/vla/locks/assets.json
RUN mkdir -p /app /root
RUN python /usr/local/lib/vla/install_locked.py robocerebra "$IMAGE_PROFILE"
RUN if [ "$IMAGE_PROFILE" = cpu ]; then python /usr/local/lib/vla/prepare_cpu.py && python /usr/local/lib/vla/prune_cpu.py; fi
RUN python /usr/local/lib/vla/export_runtime.py --inventory-only /opt/pixi/.pixi/envs/py38 /app /workspace /root /tmp/RoboCerebra
FROM builder AS assembled
RUN python /usr/local/lib/vla/assemble.py robocerebra
FROM scratch AS assets
COPY --from=assembled /opt/pixi/.pixi/envs/py38/lib/python3.8/site-packages/robosuite/models/assets /opt/pixi/.pixi/envs/py38/lib/python3.8/site-packages/robosuite/models/assets
COPY --from=assembled /runtime-root/usr/local/share/vla-build/assets.json /usr/local/share/vla-build/assets.json
FROM ${RUNTIME_IMAGE} AS runtime
ARG IMAGE_PROFILE=gpu
ENV VLA_IMAGE_PROFILE=${IMAGE_PROFILE}
COPY --from=assembled /runtime-root/opt/pixi/.pixi/envs/py38 /opt/pixi/.pixi/envs/py38
COPY --from=assembled /runtime-root/app /app
COPY --from=assembled /runtime-root/workspace /workspace
COPY --from=assembled /runtime-root/root /root
COPY --from=assembled /runtime-root/tmp/RoboCerebra /tmp/RoboCerebra
COPY --from=assembled /runtime-root/usr/local/share/vla-build /usr/local/share/vla-build
RUN dpkg-query -W > /usr/local/share/vla-build/dpkg-runtime.txt
ENV CONDA_PREFIX=/opt/pixi/.pixi/envs/py38 \
    CONDA_DEFAULT_ENV=libero \
    PATH=/opt/pixi/.pixi/envs/py38/bin:$PATH
WORKDIR /workspace
RUN vla-eval --help > /dev/null
ENTRYPOINT ["/usr/local/bin/image-entrypoint", "vla-eval"]
CMD ["run", "--config", "/workspace/configs/benchmarks/robocerebra/eval.yaml"]
FROM runtime AS full
COPY --from=assets /opt/pixi/.pixi/envs/py38/lib/python3.8/site-packages/robosuite/models/assets /opt/pixi/.pixi/envs/py38/lib/python3.8/site-packages/robosuite/models/assets
