    "rlbench": {
      "cpu": true,
      "builder": "base",
      "gpu_runtime": "base-render",
      "redistributable": false,
      "runtime_paths": [
        "/opt/pixi/.pixi/envs/py38",
        "/app",
        "/workspace",
        "/root",
        "/opt/coppeliasim",
        "/tmp/PyRep",
        "/tmp/RLBench",
        "/rlbench_entrypoint.sh"
      ],
      "runtime_instructions": [
        "ARG IMAGE_PROFILE=gpu",
        "ENV VLA_IMAGE_PROFILE=${IMAGE_PROFILE}",
        "RUN apt-get update && apt-get install -y --no-install-recommends \\",
        "        xvfb libfontconfig1 tini libdbus-1-3 \\",
        "    && rm -rf /var/lib/apt/lists/*",
        "RUN dpkg-query -W > /usr/local/share/vla-build/dpkg-runtime.txt",
        "ENV CONDA_PREFIX=/opt/pixi/.pixi/envs/py38 \\",
        "    CONDA_DEFAULT_ENV=rlbench \\",
        "    PATH=/opt/pixi/.pixi/envs/py38/bin:$PATH",
        "ENV COPPELIASIM_ROOT=/opt/coppeliasim",
        "ENV LD_LIBRARY_PATH=${COPPELIASIM_ROOT}:/usr/local/nvidia/lib:/usr/local/nvidia/lib64 \\",
        "    QT_QPA_PLATFORM_PLUGIN_PATH=${COPPELIASIM_ROOT}/platforms \\",
        "    QT_PLUGIN_PATH=${COPPELIASIM_ROOT} \\",
        "    QT_QPA_PLATFORM=xcb",
        "WORKDIR /workspace",
        "RUN vla-eval --help > /dev/null",
        "ENTRYPOINT [\"tini\", \"-g\", \"--\", \"/usr/local/bin/image-entrypoint\", \"/rlbench_entrypoint.sh\"]",
        "CMD [\"run\", \"--config\", \"/workspace/configs/benchmarks/rlbench/eval.yaml\"]"
      ],
      "torch_backend": "cpu",
      "jax": false,
      "assets": [
        "/tmp/RLBench/rlbench/assets"
