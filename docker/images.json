    "robotwin": {
      "cpu": false,
      "builder": "base-cuda",
      "gpu_runtime": "base-runtime",
      "redistributable": true,
      "runtime_paths": [
        "/opt/python",
        "/opt/venv",
        "/app",
        "/workspace",
        "/root"
      ],
      "runtime_instructions": [
        "ARG IMAGE_PROFILE=gpu",
        "ENV VLA_IMAGE_PROFILE=${IMAGE_PROFILE}",
        "# CuRobo may JIT-compile extensions; keep its CUDA toolchain at runtime.",
        "RUN apt-get update && apt-get install -y --no-install-recommends \\",
        "        build-essential cuda-nvcc-12-1 cuda-cudart-dev-12-1 ninja-build \\",
        "    && rm -rf /var/lib/apt/lists/*",
        "RUN dpkg-query -W > /usr/local/share/vla-build/dpkg-runtime.txt",
        "ENV VIRTUAL_ENV=/opt/venv \\",
        "    PATH=/opt/venv/bin:$PATH",
        "ENV TORCH_CUDA_ARCH_LIST=\"7.0;7.5;8.0;8.6;8.9;9.0+PTX\"",
        "WORKDIR /workspace",
        "RUN vla-eval --help > /dev/null",
        "ENTRYPOINT [\"vla-eval\"]",
        "CMD [\"run\", \"--config\", \"/workspace/configs/benchmarks/robotwin/eval.yaml\"]"
      ],
      "torch_backend": "cu121",
      "jax": false,
      "assets": [
