ARG BASE_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base:latest
ARG RUNTIME_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base-cpu:latest
FROM ${BASE_IMAGE} AS builder
ENV UV_TORCH_BACKEND=cpu

RUN conda create -n libero_mem python=3.8 pip -y && conda clean -afy
SHELL ["conda", "run", "-n", "libero_mem", "/bin/bash", "-c"]

RUN uv pip install --no-cache-dir "torch==2.1.0" \
        --torch-backend cpu

# robosuite/robomimic are installed from libero-mem's bundled thirdparty/
# forks (not PyPI) — they contain modifications for memory-dependent envs.
RUN uv pip install --no-cache-dir \
        numpy==1.22.4 mujoco==3.2.3 bddl==1.0.1 \
        Pillow scipy h5py pyyaml termcolor future easydict hydra-core \
        "gym>=0.21,<0.27" matplotlib \
    && rm -rf ~/.cache/pip ~/.cache/uv

ARG LIBERO_MEM_REF=0eee0defa4024e51511b6e15a79f30e9620209de
RUN mkdir -p /app/libero-mem \
    && cd /app/libero-mem \
    && git init -q \
    && git remote add origin https://github.com/libero-mem/libero-mem.git \
    && git fetch -q --depth 1 origin "${LIBERO_MEM_REF}" \
    && git checkout -q FETCH_HEAD \
    && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt \
    && cd /app/libero-mem/thirdparty/robomimic && uv pip install --no-cache-dir -e . \
    && cd /app/libero-mem/thirdparty/robosuite && uv pip install --no-cache-dir -e . \
    && cd /app/libero-mem && uv pip install --no-cache-dir --config-setting editable_mode=compat -e . \
    && rm -rf /app/libero-mem/.git ~/.cache/uv

RUN mkdir -p /root/.libero && printf '\
benchmark_root: /app/libero-mem/libero/libero\n\
bddl_files: /app/libero-mem/libero/libero/bddl_files\n\
init_states: /app/libero-mem/libero/libero/init_files\n\
datasets: /app/libero-mem/libero/datasets\n\
assets: /app/libero-mem/libero/libero/assets\n' > /root/.libero/config.yaml

# Pre-generated init states (avoids ~43 min MuJoCo generation during build)
# To regenerate, run: docker/generate_libero_mem_inits.py
COPY docker/init_states/libero_mem/ /app/libero-mem/libero/libero/init_files/libero_mem/

WORKDIR /workspace
COPY pyproject.toml README.md ./
COPY src/ src/
ARG HARNESS_VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${HARNESS_VERSION}
RUN uv pip install --no-cache-dir -e .
COPY configs/ configs/

# Export the final filesystem state; superseded wheels and build layers stay behind.
RUN python /usr/local/lib/vla/export_runtime.py /opt/conda/envs/libero_mem /app /workspace /root

FROM ${RUNTIME_IMAGE} AS runtime
COPY --from=builder /runtime-root/ /
RUN dpkg-query -W > /usr/local/share/vla-build/dpkg-runtime.txt
ENV CONDA_PREFIX=/opt/conda/envs/libero_mem \
    CONDA_DEFAULT_ENV=libero_mem \
    PATH=/opt/conda/envs/libero_mem/bin:$PATH
WORKDIR /workspace
RUN vla-eval --help > /dev/null
ENTRYPOINT ["vla-eval"]
CMD ["run", "--config", "/workspace/configs/benchmarks/libero_mem/eval.yaml"]
