# MIKASA-Robo evaluation environment
#
# ManiSkill3/SAPIEN-based memory-intensive manipulation benchmark.
# 32 tasks across categories: remember, shell-game, rotate, intercept, etc.

ARG BASE_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base:latest
ARG RUNTIME_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base-render:latest
FROM ${BASE_IMAGE} AS builder

ARG PYTHON_VERSION=3.10.18
RUN uv python install "${PYTHON_VERSION}" \
    && uv venv --seed --python "${PYTHON_VERSION}" /opt/venv
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN uv pip install --no-cache-dir torch==2.2.1 torchvision==0.17.1 \
        --torch-backend cu121

RUN uv pip install --no-cache-dir --prerelease=allow mani_skill==3.0.0b15 gymnasium==0.29.1

# MIKASA-Robo's setup.py imports pkg_resources, which was removed from
# setuptools >=70 on conda-forge. Pin setuptools <70 to restore it.
# CognitiveAISystems/MIKASA-Robo v1.0.0
ARG MIKASA_ROBO_REF=16634db18bef08128ed79346469c86fc12169aed
RUN uv pip install --no-cache-dir "setuptools<70" wheel \
    && mkdir -p /opt/MIKASA-Robo \
    && cd /opt/MIKASA-Robo \
    && git init -q \
    && git remote add origin https://github.com/CognitiveAISystems/MIKASA-Robo.git \
    && git fetch -q --depth 1 origin "${MIKASA_ROBO_REF}" \
    && git checkout -q FETCH_HEAD \
    && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt \
    && uv pip install --no-cache-dir --no-build-isolation . \
    && rm -rf /opt/MIKASA-Robo/.git

WORKDIR /workspace
COPY pyproject.toml README.md ./
COPY src/ src/
ARG HARNESS_VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${HARNESS_VERSION}
RUN uv pip install --no-cache-dir -e .

# Restore numpy 1.x compatibility (torch 2.2.1 was compiled against numpy 1.x)
RUN uv pip install --no-cache-dir "numpy==1.23.5"

COPY configs/ configs/

# Export the final filesystem state; superseded wheels and build layers stay behind.
RUN python /usr/local/lib/vla/export_runtime.py /opt/python /opt/venv /app /workspace /root /opt/MIKASA-Robo

FROM ${RUNTIME_IMAGE} AS runtime
COPY --from=builder /runtime-root/opt/python /opt/python
COPY --from=builder /runtime-root/opt/venv /opt/venv
COPY --from=builder /runtime-root/app /app
COPY --from=builder /runtime-root/workspace /workspace
COPY --from=builder /runtime-root/root /root
COPY --from=builder /runtime-root/opt/MIKASA-Robo /opt/MIKASA-Robo
COPY --from=builder /runtime-root/usr/local/share/vla-build /usr/local/share/vla-build
RUN dpkg-query -W > /usr/local/share/vla-build/dpkg-runtime.txt
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH
WORKDIR /workspace
RUN vla-eval --help > /dev/null
ENTRYPOINT ["vla-eval"]
CMD ["run", "--config", "/workspace/configs/benchmarks/mikasa/eval.yaml"]
