# Generated by docker/render.py; edit docker/recipes and docker/images.json.
# MIKASA-Robo evaluation environment
#
# ManiSkill3/SAPIEN-based memory-intensive manipulation benchmark.
# 32 tasks across categories: remember, shell-game, rotate, intercept, etc.

ARG BASE_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base:latest
ARG RUNTIME_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base-render:latest
FROM ${BASE_IMAGE} AS sources
ARG MIKASA_ROBO_REF=16634db18bef08128ed79346469c86fc12169aed
RUN mkdir -p /opt/MIKASA-Robo && cd /opt/MIKASA-Robo && git init -q && git remote add origin https://github.com/CognitiveAISystems/MIKASA-Robo.git && git fetch -q --depth 1 origin "${MIKASA_ROBO_REF}" && git checkout -q FETCH_HEAD && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt
FROM ${BASE_IMAGE} AS builder

ARG PYTHON_VERSION=3.10.18
RUN uv python install "${PYTHON_VERSION}" \
    && uv venv --seed --python "${PYTHON_VERSION}" /opt/venv
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG TORCH_BACKEND=cu121
ENV UV_TORCH_BACKEND=${TORCH_BACKEND}

RUN uv pip install --no-cache-dir torch==2.2.1 torchvision==0.17.1 \
        --torch-backend "${TORCH_BACKEND}"

RUN uv pip install --no-cache-dir --prerelease=allow mani_skill==3.0.0b15 gymnasium==0.29.1

# MIKASA-Robo's setup.py imports pkg_resources, which was removed from
# setuptools >=70 on conda-forge. Pin setuptools <70 to restore it.
# CognitiveAISystems/MIKASA-Robo v1.0.0
COPY --from=sources /usr/local/share/vla-build/sources.txt /usr/local/share/vla-build/sources.txt
COPY --from=sources /opt/MIKASA-Robo /opt/MIKASA-Robo
RUN uv pip install --no-cache-dir "setuptools<70" wheel \
    && mkdir -p /opt/MIKASA-Robo \
    && cd /opt/MIKASA-Robo \
    && uv pip install --no-cache-dir --no-build-isolation . \
    && rm -rf /opt/MIKASA-Robo/.git
COPY docker/images.json /usr/local/lib/vla/images.json
ARG IMAGE_PROFILE=gpu
COPY docker/locks/mikasa_robo-${IMAGE_PROFILE}.txt /usr/local/lib/vla/locks/mikasa_robo-${IMAGE_PROFILE}.txt
COPY docker/locks/assets.json /usr/local/lib/vla/locks/assets.json
RUN mkdir -p /app /root
RUN python /usr/local/lib/vla/install_locked.py mikasa_robo "$IMAGE_PROFILE"
WORKDIR /workspace
COPY pyproject.toml README.md ./
COPY src/ src/
ARG HARNESS_VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${HARNESS_VERSION}
RUN uv pip install --no-cache-dir --no-deps -e .
COPY configs/ configs/
RUN python /usr/local/lib/vla/export_runtime.py --inventory-only /opt/python /opt/venv /app /workspace /root /opt/MIKASA-Robo
FROM builder AS assembled
RUN python /usr/local/lib/vla/assemble.py mikasa_robo
FROM scratch AS assets
COPY --from=assembled /runtime-root/usr/local/share/vla-build/assets.json /usr/local/share/vla-build/assets.json
FROM ${RUNTIME_IMAGE} AS runtime
ARG IMAGE_PROFILE=gpu
ENV VLA_IMAGE_PROFILE=${IMAGE_PROFILE}
COPY --from=assembled /runtime-root/opt/python /opt/python
COPY --from=assembled /runtime-root/opt/venv /opt/venv
COPY --from=assembled /runtime-root/app /app
COPY --from=assembled /runtime-root/workspace /workspace
COPY --from=assembled /runtime-root/root /root
COPY --from=assembled /runtime-root/opt/MIKASA-Robo /opt/MIKASA-Robo
COPY --from=assembled /runtime-root/usr/local/share/vla-build /usr/local/share/vla-build
RUN dpkg-query -W > /usr/local/share/vla-build/dpkg-runtime.txt
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH
WORKDIR /workspace
RUN vla-eval --help > /dev/null
ENTRYPOINT ["vla-eval"]
CMD ["run", "--config", "/workspace/configs/benchmarks/mikasa/eval.yaml"]
FROM runtime AS full
