ARG BASE_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base:latest
ARG RUNTIME_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base-render:latest
FROM ${BASE_IMAGE} AS builder

# ── uv environment ──────────────────────────────────────────────
ARG PYTHON_VERSION=3.11.13
RUN uv python install "${PYTHON_VERSION}" \
    && uv venv --seed --python "${PYTHON_VERSION}" /opt/venv
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# ── Kinetix ───────────────────────────────────────────────────────
# FLAIROx/Kinetix v3.0.0
ARG KINETIX_REF=67f89f45e32cfd7899bc63e252a6b044eacafb83
RUN mkdir -p /opt/kinetix \
    && cd /opt/kinetix \
    && git init -q \
    && git remote add origin https://github.com/FLAIROx/Kinetix.git \
    && git fetch -q --depth 1 origin "${KINETIX_REF}" \
    && git checkout -q FETCH_HEAD \
    && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt \
    && uv pip install --no-cache-dir -e . numpy Pillow

# ── JAX with CUDA support (after kinetix to override its JAX pin) ─
RUN uv pip install --no-cache-dir --upgrade "jax[cuda12]"

# ── RTC level files ───────────────────────────────────────────────
ARG RTC_KINETIX_REF=9296f31d62d5bfeb5779dcb2f9bcf71ca37f448b
RUN mkdir -p /app/rtc \
    && cd /app/rtc \
    && git init -q \
    && git remote add origin https://github.com/Physical-Intelligence/real-time-chunking-kinetix.git \
    && git fetch -q --depth 1 origin "${RTC_KINETIX_REF}" \
    && git checkout -q FETCH_HEAD \
    && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt \
    && rm -rf /app/rtc/.git

WORKDIR /workspace
COPY pyproject.toml README.md ./
COPY src/ src/
ARG HARNESS_VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${HARNESS_VERSION}
RUN uv pip install --no-cache-dir -e .
COPY configs/ configs/

# Export the final filesystem state; superseded wheels and build layers stay behind.
RUN python /usr/local/lib/vla/export_runtime.py /opt/python /opt/venv /app /workspace /root /opt/kinetix

FROM ${RUNTIME_IMAGE} AS runtime
ARG IMAGE_PROFILE=gpu
ENV VLA_IMAGE_PROFILE=${IMAGE_PROFILE}
COPY --from=builder /runtime-root/opt/python /opt/python
COPY --from=builder /runtime-root/opt/venv /opt/venv
COPY --from=builder /runtime-root/app /app
COPY --from=builder /runtime-root/workspace /workspace
COPY --from=builder /runtime-root/root /root
COPY --from=builder /runtime-root/opt/kinetix /opt/kinetix
COPY --from=builder /runtime-root/usr/local/share/vla-build /usr/local/share/vla-build
RUN dpkg-query -W > /usr/local/share/vla-build/dpkg-runtime.txt
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH
WORKDIR /workspace
RUN vla-eval --help > /dev/null
ENTRYPOINT ["/usr/local/bin/image-entrypoint", "vla-eval"]
CMD ["run", "--config", "/workspace/configs/benchmarks/kinetix/eval.yaml"]
