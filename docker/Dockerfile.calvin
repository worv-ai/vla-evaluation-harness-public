# Generated by docker/render.py; edit docker/recipes and docker/images.json.
# CALVIN evaluation environment
# Long-horizon language-conditioned manipulation benchmark
# https://github.com/mees/calvin

ARG BASE_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base:latest
ARG RUNTIME_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base-render:latest
FROM ${BASE_IMAGE} AS sources
ARG CALVIN_REF=fa03f01f19c65920e18cf37398a9ce859274af76
RUN mkdir -p /app/calvin && cd /app/calvin && git init -q && git remote add origin https://github.com/mees/calvin.git && git fetch -q --depth 1 origin "${CALVIN_REF}" && git checkout -q FETCH_HEAD && git submodule update --init --recursive --depth 1 && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt
FROM ${BASE_IMAGE} AS builder
ARG BUILD_JOBS=4
ENV MAX_JOBS=${BUILD_JOBS} CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_JOBS}

ARG PYTHON_VERSION=3.11.13
RUN uv python install "${PYTHON_VERSION}" \
    && uv venv --seed --python "${PYTHON_VERSION}" /opt/venv
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY --from=sources /usr/local/share/vla-build/sources.txt /usr/local/share/vla-build/sources.txt
COPY --from=sources /app/calvin /app/calvin

ARG TORCH_BACKEND=cpu
ENV UV_TORCH_BACKEND=${TORCH_BACKEND}

# calvin_models pins torch==1.13.1, hydra-core==1.1.1 and pyhash, none of which install on 3.11, so it goes
# in --no-deps with what the eval path imports. torch 2.1.0 and numpy 1.24.4 are what the 3.8 image ran.
RUN uv pip install --no-cache-dir "numpy==1.24.4" "torch==2.1.0" "torchvision==0.16.0" --torch-backend "${TORCH_BACKEND}"
RUN cd /app/calvin/calvin_env && uv pip install --no-cache-dir "numpy==1.24.4" -e . \
    && cd /app/calvin/calvin_models && uv pip install --no-cache-dir --no-deps -e . \
    && uv pip install --no-cache-dir "numpy==1.24.4" "hydra-core==1.3.2" hydra-colorlog omegaconf matplotlib \
        opencv-python plotly "pytorch-lightning==1.8.6" lightning_lite gitpython scipy gym moviepy tqdm \
        termcolor fnvhash "setuptools<70"
# pyhash does not build on 3.11; calvin imports it at module level but the eval path never hashes with it.
RUN sed -i 's/^import pyhash$/import fnvhash/; s/^hasher = pyhash.fnv1_32()$/hasher = lambda s: fnvhash.fnv1_32(s.encode())/' \
    /app/calvin/calvin_models/calvin_agent/evaluation/utils.py /app/calvin/calvin_models/calvin_agent/datasets/base_dataset.py

# Patch: catch pybullet.error on double-disconnect during GC teardown
# (upstream only catches TypeError, not pybullet.error)
RUN sed -i 's/except TypeError:/except Exception:/' \
    /app/calvin/calvin_env/calvin_env/envs/play_table_env.py

# Remove .git history to shrink image, then re-init minimal repos
# (CALVIN calls git diff internally via get_git_commit_hash)
RUN find /app/calvin -name .git -exec rm -rf {} + 2>/dev/null || true \
    && git config --global user.email "x" && git config --global user.name "x" \
    && git -C /app/calvin/calvin_env init -q && git -C /app/calvin/calvin_env add -A && git -C /app/calvin/calvin_env commit -qm init \
    && git -C /app/calvin init -q && git -C /app/calvin add -A && git -C /app/calvin commit -qm init

# Embed CALVIN validation config (17KB) — no volume mount needed
COPY docker/calvin_validation_data/ /data/calvin/dataset/validation/

WORKDIR /workspace

# CALVIN otherwise compiles this GPU-discovery helper on first reset.
RUN cd /app/calvin/calvin_env/egl_check && bash build.sh && test -x EGL_options.o
COPY docker/images.json /usr/local/lib/vla/images.json
ARG IMAGE_PROFILE=gpu
COPY docker/locks/calvin.in /usr/local/lib/vla/locks/calvin.in
COPY docker/locks/hashes.txt docker/locks/assets.json /usr/local/lib/vla/locks/
RUN mkdir -p /app /root
RUN python /usr/local/lib/vla/install_locked.py calvin "$IMAGE_PROFILE"
WORKDIR /workspace
COPY pyproject.toml README.md ./
COPY src/ src/
ARG HARNESS_VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${HARNESS_VERSION}
RUN uv pip install --no-cache-dir --no-deps -e .
COPY configs/ configs/
RUN if [ "$IMAGE_PROFILE" = cpu ]; then python /usr/local/lib/vla/prepare_cpu.py && python /usr/local/lib/vla/prune_cpu.py; fi
RUN python /usr/local/lib/vla/export_runtime.py --inventory-only /opt/python /opt/venv /app /workspace /root /data
FROM builder AS assembled
RUN python /usr/local/lib/vla/assemble.py calvin
FROM scratch AS assets
COPY --from=assembled /app/calvin/calvin_env/data /app/calvin/calvin_env/data
COPY --from=assembled /app/calvin/calvin_env/tacto/meshes /app/calvin/calvin_env/tacto/meshes
COPY --from=assembled /data /data
COPY --from=assembled /runtime-root/usr/local/share/vla-build/assets.json /usr/local/share/vla-build/assets.json
FROM ${RUNTIME_IMAGE} AS runtime
ARG IMAGE_PROFILE=gpu
ENV VLA_IMAGE_PROFILE=${IMAGE_PROFILE}
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=assembled /runtime-root/opt/python /opt/python
COPY --from=assembled /runtime-root/opt/venv /opt/venv
COPY --from=assembled /runtime-root/app /app
COPY --from=assembled /runtime-root/workspace /workspace
COPY --from=assembled /runtime-root/root /root
COPY --from=assembled /runtime-root/data /data
COPY --from=assembled /runtime-root/usr/local/share/vla-build /usr/local/share/vla-build
RUN dpkg-query -W > /usr/local/share/vla-build/dpkg-runtime.txt
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH
WORKDIR /workspace
RUN vla-eval --help > /dev/null
ENTRYPOINT ["/usr/local/bin/image-entrypoint", "vla-eval"]
CMD ["run", "--config", "/workspace/configs/benchmarks/calvin/eval.yaml"]
FROM runtime AS full
COPY --from=assets /app/calvin/calvin_env/data /app/calvin/calvin_env/data
COPY --from=assets /app/calvin/calvin_env/tacto/meshes /app/calvin/calvin_env/tacto/meshes
COPY --from=assets /data /data
