# Generated by docker/render.py; edit docker/recipes and docker/images.json.
# RoboCasa365 multi-task kitchen manipulation evaluation environment
#
# Both projects are pinned past their latest tag: the fixes this benchmark
# needs shipped without a new semantic version, so each install is checked
# against the version the pinned revision declares.

ARG BASE_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base:latest
ARG RUNTIME_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base-render:latest
FROM ${BASE_IMAGE} AS sources
ARG ROBOSUITE_REF=5ce6643f3092639d08f7b0f90ed1c6a84f50552c
RUN mkdir -p /app/robosuite && cd /app/robosuite && git init -q && git remote add origin https://github.com/ARISE-Initiative/robosuite.git && git fetch -q --depth 1 origin "${ROBOSUITE_REF}" && git checkout -q FETCH_HEAD && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt
ARG ROBOCASA365_REF=b4684e6ee37d377cc392e98302a6b916d588b415
RUN mkdir -p /app/robocasa365 && cd /app/robocasa365 && git init -q && git remote add origin https://github.com/robocasa/robocasa.git && git fetch -q --depth 1 origin "${ROBOCASA365_REF}" && git checkout -q FETCH_HEAD && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt
FROM ${BASE_IMAGE} AS builder
ARG TORCH_BACKEND=cpu
ENV UV_TORCH_BACKEND=${TORCH_BACKEND}

ARG PYTHON_VERSION=3.11.13
RUN uv python install "${PYTHON_VERSION}" \
    && uv venv --seed --python "${PYTHON_VERSION}" /opt/venv
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG ROBOSUITE_VERSION=1.5.2
COPY --from=sources /usr/local/share/vla-build/sources.txt /usr/local/share/vla-build/sources.txt
COPY --from=sources /app/robosuite /app/robosuite
RUN mkdir -p /app/robosuite \
    && cd /app/robosuite \
    &&      uv pip install --no-cache-dir -e . \
    && test "$(python -c 'from importlib.metadata import version; print(version("robosuite"))')" = "${ROBOSUITE_VERSION}" \
    && rm -rf /app/robosuite/.git

ARG ROBOCASA365_VERSION=1.0.1
COPY --from=sources /app/robocasa365 /app/robocasa365
RUN mkdir -p /app/robocasa365 \
    && cd /app/robocasa365 \
    &&      uv pip install --no-cache-dir -e . \
    && test "$(python -c 'from importlib.metadata import version; print(version("robocasa"))')" = "${ROBOCASA365_VERSION}" \
    && rm -rf /app/robocasa365/.git

# Setup macros (non-interactive) and download kitchen assets (~10 GB)

RUN cd /app/robocasa365 \
    && python robocasa/scripts/setup_macros.py \
    && echo "y" | python robocasa/scripts/download_kitchen_assets.py
COPY docker/images.json /usr/local/lib/vla/images.json
ARG IMAGE_PROFILE=gpu
COPY docker/locks/robocasa365-${IMAGE_PROFILE}.txt /usr/local/lib/vla/locks/robocasa365-${IMAGE_PROFILE}.txt
COPY docker/locks/assets.json /usr/local/lib/vla/locks/assets.json
RUN mkdir -p /app /root
RUN python /usr/local/lib/vla/install_locked.py robocasa365 "$IMAGE_PROFILE"
WORKDIR /workspace
COPY pyproject.toml README.md ./
COPY src/ src/
ARG HARNESS_VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${HARNESS_VERSION}
RUN uv pip install --no-cache-dir --no-deps -e .
COPY configs/ configs/
RUN if [ "$IMAGE_PROFILE" = cpu ]; then python /usr/local/lib/vla/prepare_cpu.py && python /usr/local/lib/vla/prune_cpu.py; fi
RUN python /usr/local/lib/vla/export_runtime.py --inventory-only /opt/python /opt/venv /app /workspace /root
FROM builder AS assembled
RUN python /usr/local/lib/vla/assemble.py robocasa365
FROM scratch AS assets
COPY --from=assembled /app/robocasa365/robocasa/models/assets /app/robocasa365/robocasa/models/assets
COPY --from=assembled /app/robosuite/robosuite/models/assets /app/robosuite/robosuite/models/assets
COPY --from=assembled /runtime-root/usr/local/share/vla-build/assets.json /usr/local/share/vla-build/assets.json
FROM ${RUNTIME_IMAGE} AS runtime
ARG IMAGE_PROFILE=gpu
ENV VLA_IMAGE_PROFILE=${IMAGE_PROFILE}
COPY --from=assembled /runtime-root/opt/python /opt/python
COPY --from=assembled /runtime-root/opt/venv /opt/venv
COPY --from=assembled /runtime-root/app /app
COPY --from=assembled /runtime-root/workspace /workspace
COPY --from=assembled /runtime-root/root /root
COPY --from=assembled /runtime-root/usr/local/share/vla-build /usr/local/share/vla-build
RUN dpkg-query -W > /usr/local/share/vla-build/dpkg-runtime.txt
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH
WORKDIR /workspace
RUN vla-eval --help > /dev/null
ENTRYPOINT ["/usr/local/bin/image-entrypoint", "vla-eval"]
CMD ["run", "--config", "/workspace/configs/benchmarks/robocasa365/eval.yaml"]
FROM runtime AS full
COPY --from=assets /app/robocasa365/robocasa/models/assets /app/robocasa365/robocasa/models/assets
COPY --from=assets /app/robosuite/robosuite/models/assets /app/robosuite/robosuite/models/assets
