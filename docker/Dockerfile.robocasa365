# RoboCasa365 multi-task kitchen manipulation evaluation environment
#
# Both projects are pinned past their latest tag: the fixes this benchmark
# needs shipped without a new semantic version, so each install is checked
# against the version the pinned revision declares.

ARG BASE_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base:latest
ARG RUNTIME_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base-cpu:latest
FROM ${BASE_IMAGE} AS builder
ENV UV_TORCH_BACKEND=cpu

ARG PYTHON_VERSION=3.11.13
RUN uv python install "${PYTHON_VERSION}" \
    && uv venv --seed --python "${PYTHON_VERSION}" /opt/venv
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG ROBOSUITE_VERSION=1.5.2
ARG ROBOSUITE_REF=5ce6643f3092639d08f7b0f90ed1c6a84f50552c
RUN mkdir -p /app/robosuite && \
    cd /app/robosuite && \
    git init -q && \
    git remote add origin https://github.com/ARISE-Initiative/robosuite.git && \
    git fetch -q --depth 1 origin "${ROBOSUITE_REF}" && \
    git checkout -q FETCH_HEAD \
    && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt && \
    uv pip install --no-cache-dir -e . && \
    test "$(python -c 'from importlib.metadata import version; print(version("robosuite"))')" = "${ROBOSUITE_VERSION}" && \
    rm -rf /app/robosuite/.git

ARG ROBOCASA365_VERSION=1.0.1
ARG ROBOCASA365_REF=b4684e6ee37d377cc392e98302a6b916d588b415
RUN mkdir -p /app/robocasa365 && \
    cd /app/robocasa365 && \
    git init -q && \
    git remote add origin https://github.com/robocasa/robocasa.git && \
    git fetch -q --depth 1 origin "${ROBOCASA365_REF}" && \
    git checkout -q FETCH_HEAD \
    && { git remote get-url origin; git rev-parse HEAD; } >> /usr/local/share/vla-build/sources.txt && \
    uv pip install --no-cache-dir -e . && \
    test "$(python -c 'from importlib.metadata import version; print(version("robocasa"))')" = "${ROBOCASA365_VERSION}" && \
    rm -rf /app/robocasa365/.git

# Setup macros (non-interactive) and download kitchen assets (~10 GB)
RUN cd /app/robocasa365 \
    && python robocasa/scripts/setup_macros.py \
    && echo "y" | python robocasa/scripts/download_kitchen_assets.py

WORKDIR /workspace
COPY pyproject.toml README.md ./
COPY src/ src/
ARG HARNESS_VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${HARNESS_VERSION}
RUN uv pip install --no-cache-dir -e .
COPY configs/ configs/

# Export the final filesystem state; superseded wheels and build layers stay behind.
RUN python /usr/local/lib/vla/export_runtime.py /opt/python /opt/venv /app /workspace /root

FROM ${RUNTIME_IMAGE} AS runtime
COPY --from=builder /runtime-root/ /
RUN dpkg-query -W > /usr/local/share/vla-build/dpkg-runtime.txt
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH
WORKDIR /workspace
RUN vla-eval --help > /dev/null
ENTRYPOINT ["vla-eval"]
CMD ["run", "--config", "/workspace/configs/benchmarks/robocasa365/eval.yaml"]
