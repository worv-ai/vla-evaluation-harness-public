# Shared runtime and build-only toolchain. See docker/README.md.
ARG OS_IMAGE=ubuntu:22.04@sha256:829f6df217bcbae2b371026e81711d1a787c61b2967ad09d015063663ebafbf7
FROM ${OS_IMAGE} AS runtime-common

LABEL org.opencontainers.image.source=https://github.com/allenai/vla-evaluation-harness

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY --from=ghcr.io/prefix-dev/pixi:0.80.0@sha256:4cb073300e2c5eaee287bb3bcbadd3ddb7bce4ce36b27c41a19aad74c297c2f3 /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
ARG UBUNTU_SNAPSHOT=20260914T000000Z
COPY docker/snapshot_apt.sh /usr/local/bin/snapshot-apt
RUN snapshot-apt "$UBUNTU_SNAPSHOT"

# Rendering libraries shared by the supported simulators.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libgomp1 libstdc++6 \
        # EGL / OpenGL
        libegl1 libgl1 libgl1-mesa-glx libgles2 \
        libglfw3 libosmesa6 libglew2.2 libglvnd0 \
        # Vulkan
        libvulkan1 mesa-vulkan-drivers \
        # X11 / misc
        libglib2.0-0 libsm6 libxext6 libxrender1 \
        libxcb-xinerama0 libxkbcommon-x11-0 \
    && rm -rf /var/lib/apt/lists/*

COPY docker/image_entrypoint.sh /usr/local/bin/image-entrypoint

FROM runtime-common AS runtime-cpu
ENV MUJOCO_GL=osmesa PYOPENGL_PLATFORM=osmesa \
    LIBGL_ALWAYS_SOFTWARE=1 NVIDIA_VISIBLE_DEVICES=void \
    CUDA_VISIBLE_DEVICES="" JAX_PLATFORMS=cpu \
    VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.x86_64.json

FROM runtime-common AS runtime
ENV MUJOCO_GL=egl PYOPENGL_PLATFORM=egl EGL_PLATFORM=device \
    NVIDIA_DRIVER_CAPABILITIES=all NVIDIA_VISIBLE_DEVICES=all

# ── Vulkan ICD for NVIDIA GPU ────────────────────────────────────────
# Skip writes when the ICD file is already present — on hosts whose Docker
# default-runtime is `nvidia`, nvidia-container-runtime bind-mounts these
# JSONs read-only into every container (including the build container), so
# an unconditional write would fail with "Read-only file system".
RUN mkdir -p /usr/share/vulkan/icd.d /usr/share/glvnd/egl_vendor.d \
    && { [ -s /usr/share/vulkan/icd.d/nvidia_icd.json ] \
         || printf '{"file_format_version":"1.0.0","ICD":{"library_path":"libGLX_nvidia.so.0","api_version":"1.2.155"}}\n' \
            > /usr/share/vulkan/icd.d/nvidia_icd.json; } \
    && { [ -s /usr/share/glvnd/egl_vendor.d/10_nvidia.json ] \
         || printf '{"file_format_version":"1.0.0","ICD":{"library_path":"libEGL_nvidia.so.0"}}\n' \
            > /usr/share/glvnd/egl_vendor.d/10_nvidia.json; }

WORKDIR /workspace

FROM runtime AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git wget curl unzip patch \
        libegl1-mesa-dev libosmesa6-dev libglew-dev libglvnd-dev libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# Pixi installs locked native environments without a Conda base environment.
COPY --from=ghcr.io/prefix-dev/pixi:0.80.0@sha256:4cb073300e2c5eaee287bb3bcbadd3ddb7bce4ce36b27c41a19aad74c297c2f3 /usr/local/bin/pixi /usr/local/bin/pixi
ENV PIXI_NO_CONFIG=true PIXI_CACHE_DIR=/tmp/pixi-cache
RUN pixi --version
COPY docker/pixi/pixi.toml docker/pixi/pixi.lock /opt/pixi/
COPY docker/install_native.sh /usr/local/bin/install-native-env

# ── uv (fast Python package installer) ───────────────────────────────
COPY --from=ghcr.io/astral-sh/uv:0.11.25@sha256:1e3808aa9023d0980e7c15b1fa7c1ac16ff35925780cf5c459858b2d693f01a9 /uv /usr/local/bin/uv
ARG UV_EXCLUDE_NEWER=2026-07-07
ENV UV_EXCLUDE_NEWER=${UV_EXCLUDE_NEWER} \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_LINK_MODE=copy

WORKDIR /workspace

RUN mkdir -p /usr/local/share/vla-build
COPY docker/export_runtime.py docker/optimize_libero.py docker/prepare_cpu.py docker/prune_cpu.py docker/assemble.py docker/split_assets.py docker/install_locked.py docker/verify_assets.py /usr/local/lib/vla/
